{
  "expo": {
    "name": "EsnafGIS Mobil",
    "slug": "esnaf-gis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera QR kod tarama işlemi için gereklidir."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      }
    }
  }
}
