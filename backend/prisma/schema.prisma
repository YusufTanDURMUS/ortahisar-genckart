generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Kullanıcı Modeli (Ortak Auth Tablosu)
// Roles: STUDENT | MERCHANT | ADMIN
// ------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  role          String    @default("STUDENT")
  email         String?   @unique
  passwordHash  String?   // Esnaf ve Admin için şifre
  phoneNumber   String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // İlişkiler
  studentProfile StudentProfile?
  merchantProfile MerchantProfile?

  @@map("users")
}

// ------------------------------------------------------
// Öğrenci Profili (e-Devlet Onaylı Gençler)
// ------------------------------------------------------

model StudentProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tcKn              String   @unique // TC Kimlik No
  belediyeStudentId String?  // Belediyenin sistemindeki ID (Örn: BEL-STUDENT-1110)
  firstName         String
  lastName          String
  birthYear         Int      @default(2002)
  schoolName        String?  @default("Karadeniz Teknik Üniversitesi (KTÜ)") // Okuduğu Okul
  district          String   @default("Ortahisar") // İkamet / Okul İlçesi
  isEligible        Boolean  @default(true) // Aktif öğrencilik/şart durumu
  statusReason      String   @default("ACTIVE") // Örn: ACTIVE, AGE_LIMIT_EXCEEDED, RESIDENCE_MISMATCH, STUDENT_STATUS_INACTIVE
  revokedNote       String?  // Ek açıklama
  edevletRefCode    String?  // e-Devlet doğrulama referans kodu

  transactions      Transaction[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("student_profiles")
}

// ------------------------------------------------------
// Esnaf / İşletme Profili
// ------------------------------------------------------

model MerchantProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String   // İşletme Adı (Örn: X Kitabevi)
  category            String   // Kategori (Kafe, Restoran, Kırtasiye vb.)
  address             String?
  taxNumber           String?  // Vergi Numarası
  symbol              String?  // İşletme Sembolü/Emojisi (Örn: 📚, ☕, 🛍️, 💻 veya boş)
  
  defaultDiscountRate Float    // Aktif geçerli indirim oranı (Örn: 15.0 -> %15)
  qrCodeIdentifier    String   @unique @default(uuid()) // Kasadaki Statik QR kimliği

  merchantRequests    MerchantRequest[]
  storeLocations      StoreLocation[]
  transactions        Transaction[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("merchant_profiles")
}

// ------------------------------------------------------
// Esnaf Talepleri (İndirim, Adres, Yeni Konum vb.)
// Statuses: PENDING | APPROVED | REJECTED
// ------------------------------------------------------

model MerchantRequest {
  id                String          @id @default(uuid())
  merchantId        String
  merchant          MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  type                  String          // 'DISCOUNT_UPDATE', 'LOCATION_UPDATE', 'NEW_LOCATION'
  status                String          @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED'
  payload               String          // JSON string olarak (eski talepler için)
  
  // İndirim Talebi Alanları
  requestedDiscountRate Float?
  categoryDiscounts     String?         // SQLite olduğu için listeyi JSON string olarak tutacağız

  // Şube & Adres Talebi Alanları
  targetLocationId      String?
  targetLocationTitle   String?
  city                  String?
  district              String?
  neighborhood          String?
  street                String?
  buildingNo            String?
  apartmentNo           String?
  fullAddress           String?
  symbol                String?         // Şube Sembolü (Örn: 📍, 🏢, ⭐)
  latitude              Float?
  longitude             Float?

  rejectionReason       String?         // Red gerekçesi

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("merchant_requests")
}

// ------------------------------------------------------
// Esnaf Şubeleri / Konumları
// ------------------------------------------------------

model StoreLocation {
  id                String          @id @default(uuid())
  merchantId        String
  merchant          MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  title             String          // Örn: "Merkez Şube"
  address           String
  symbol            String?         // Şube Sembolü (Örn: ⭐, 📍, 🏢 veya boş)
  latitude          Float?
  longitude         Float?
  isMain            Boolean         @default(false)

  createdAt         DateTime        @default(now())

  @@map("store_locations")
}

// ------------------------------------------------------
// İndirim Kullanım Geçmişi (Log / İşlemler)
// ------------------------------------------------------

model Transaction {
  id                String          @id @default(uuid())
  
  studentId         String
  student           StudentProfile  @relation(fields: [studentId], references: [id])

  merchantId        String
  merchant          MerchantProfile @relation(fields: [merchantId], references: [id])

  originalAmount    Float           // İndirimsiz Tutar (Örn: 500 TL)
  discountRate      Float           // Uygulanan İndirim Oranı (%20)
  discountedAmount  Float           // Ödenen İndirimli Tutar (Örn: 400 TL)
  savedAmount       Float           // Öğrencinin Karlılığı (Örn: 100 TL)

  integrationType   String          // 'KEYBOARD_WEDGE', 'PWA_SCAN', 'STATIC_QR'
  verificationCode  String          // İşlem doğrulama / onay kodu
  status            String          @default("PENDING") // 'PENDING' | 'COMPLETED' | 'CANCELLED'

  createdAt         DateTime        @default(now())

  @@map("transactions")
}
