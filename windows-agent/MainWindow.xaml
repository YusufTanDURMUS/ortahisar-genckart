<Window x:Class="EsnafAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Esnaf Ajanı v1.0 (.NET 8 SendKeys Entegre)" Height="450" Width="600"
        Background="#0b0f19" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#374151" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                <StackPanel>
                    <TextBlock Text="🖥️ Windows Esnaf Masaüstü Ajanı" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Windows API &amp; SendKeys Otomatik Yazar Kasa Aktarımı" Foreground="#818cf8" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Border x:Name="StatusBadge" Background="#064e3b" CornerRadius="10" Padding="10,4">
                    <TextBlock x:Name="StatusText" Text="● Backend Bağlı" Foreground="#34d399" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Direct Actions Card -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#475569" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="⚡ Yazar Kasaya SendKeys ile Veri Simülasyonu" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInput" Grid.Column="0" Height="38" Background="#0f172a" Foreground="#34d399" FontSize="14" FontWeight="Bold" Padding="8,6" BorderBrush="#6366f1" BorderThickness="1" Text="QR-984214-TEST"/>
                    <Button Grid.Column="1" Click="BtnSendKeys_Click" Content="Kasaya Yaz (SendKeys)" Width="170" Margin="10,0,0,0" Background="#4f46e5" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Activity Log -->
        <Border Grid.Row="2" Background="#111827" CornerRadius="12" Padding="12" BorderBrush="#374151" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="📋 Ajan Olay &amp; İşlem Günlüğü" DockPanel.Dock="Top" Foreground="#9ca3af" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox x:Name="LstLogs" Background="#030712" Foreground="#34d399" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="SpaceBetween" Margin="0,12,0,0">
            <TextBlock Text=".NET 8 Windows API | SendKeys.SendWait Entegre" Foreground="#6b7280" FontSize="10"/>
            <Button Content="Sistem Tepsisine Küçült (Tray)" Click="BtnTray_Click" Background="#374151" Foreground="#d1d5db" FontSize="10" Padding="8,4"/>
        </StackPanel>
    </Grid>
</Window>
